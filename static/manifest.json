{
  "manifest_version": 3,
  "name": "Persistent Search Filters for Indeed",
  "version": "1.0.0",
  "description": "Keep a saved list of excluded words for Indeed job searches, without losing your pay, radius and other filters.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.indeed.com/jobs*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "persistent-search-filters@mike-silverman",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
